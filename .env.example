# =============================================================================
# 平台配置示例。复制为 .env（本地开发）或 /etc/bedrock/bedrock.env（systemd）。
# 本文件不包含任何真实凭证，请勿把真实 Key 提交到版本库。
# =============================================================================

# --- 基础 ---------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
BIND_HOST=127.0.0.1
BIND_PORT=8000
# 若通过 HTTPS 反向代理对外提供服务，填写外部访问地址（用于 Origin 校验）
PUBLIC_ORIGIN=

# --- 存储 ---------------------------------------------------------------
DB_PATH=/opt/bedrock/data/bedrock.db
LOG_PATH=/opt/bedrock/logs/bedrock.log

# --- 会话 ---------------------------------------------------------------
SESSION_COOKIE_NAME=bedrock_sid
# 仅在 HTTPS 环境设置为 true
COOKIE_SECURE=false
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800

# --- 登录保护 -----------------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
PASSWORD_MIN_LENGTH=12
# 首次启动且数据库无账号时用于创建管理员；创建完成后请从环境文件中移除
BEDROCK_ADMIN_USER=admin
BEDROCK_ADMIN_PASSWORD=

# --- 模型测试 -----------------------------------------------------------
MODEL_CONNECT_TIMEOUT=10
MODEL_FIRST_TOKEN_TIMEOUT=30
MODEL_TOTAL_TIMEOUT=60
MODEL_MAX_BODY_BYTES=2097152
MODEL_MAX_CONCURRENCY=6
# 相邻两次上游请求的默认最小间隔（秒），0 = 不限速。
# 验收一轮要连发十几个请求，背靠背发容易撞网关 RPM 限流（429）；
# 429 会被写成判定结论，等于拿平台的请求节奏去扣供应商的分。
# 任务表单里的「请求间隔」会覆盖这里的默认值。
MODEL_REQUEST_INTERVAL=2
MODEL_REPEAT=3
# 仅当需要测试私有化部署/内网模型时开启；开启后务必确认网络边界
ALLOW_PRIVATE_UPSTREAM=false
# 精确放行的主机名（逗号分隔），优先级高于私网限制
UPSTREAM_EXTRA_HOSTS=
# 始终禁止的主机名后缀（逗号分隔）
UPSTREAM_BLOCKED_HOSTS=
UPSTREAM_USER_AGENT=bedrock-endpoint-test/1.0

# --- Shell 工作进程 -----------------------------------------------------
SHELL_ENABLED=true
SHELL_SOCKET=/run/bedrock/shell.sock
# Windows 开发环境使用 TCP；生产环境使用上面的 unix socket
SHELL_HOST=127.0.0.1
SHELL_PORT=9700
# 主服务与工作进程共享的调用令牌，生成方式：openssl rand -hex 32
SHELL_TOKEN=
SHELL_REQUEST_TIMEOUT=45
SHELL_RATE_PER_MINUTE=30

# --- 反向代理 -----------------------------------------------------------
# 仅在 Nginx 同机部署时设为 true，否则客户端 IP 可被伪造
TRUST_PROXY_HEADERS=true
ALLOWED_ORIGINS=
